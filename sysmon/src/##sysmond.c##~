#include <stdio.h>
#include <stdlib.h>
#include <sys/stat.h>
#include <errno.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <string.h>
#include <fcntl.h>
#include <sysmon_ipc.h>

int fds[2] = {-1, -1};
int cpu_fd = -1;
int proc_fd = -1;

extern char **environ;


int make_pipe(void) {
    if (pipe(fds) == -1) {
        perror("pipe");
        return 1;
    }

    return 0;
}


int make_fifo(const char *path) {
    if (mkfifo(path, 0666) == -1) {
        if (errno == EEXIST)
            return 0;

        perror("mkfifo");
        return 1;
    }

    return 0;
}


int receive_data(int fd, void *buffer, size_t size) {
    char *ptr = (char *)buffer;
    size_t received = 0;

    while (received < size) {
        ssize_t n = read(fd, ptr + received, size - received);

        if (n < 0) {
            if (errno == EINTR)
                continue;

            perror("read");
            return -1;
        }

        if (n == 0) {
            if (received == 0)
                return 0;

            fprintf(stderr,
                    "Incomplete data received (%zu/%zu bytes)\n",
                    received, size);

            return -1;
        }

        received += n;
    }

    return 1;
}


/* Memory sensor: anonymous pipe */

int get_mem_data(int fd) {
    MemData data;

    int result = receive_data(fd, &data, sizeof(data));

    if (result != 1)
        return result;

    printf("\n--- Memory Information ---\n");
    printf("Total memory:     %ld kB\n", data.mem_total);
    printf("Free memory:      %ld kB\n", data.mem_free);
    printf("Available memory: %ld kB\n", data.mem_avail);
    printf("Total swap:       %ld kB\n", data.swap_total);
    printf("Free swap:        %ld kB\n", data.swap_free);

    return 1;
}


/* CPU sensor: named FIFO */

int get_cpu_data(int fd) {
    CpuData data;

    int result = receive_data(fd, &data, sizeof(data));

    if (result != 1)
        return result;

    printf("\n--- CPU Information ---\n");
    printf("Load average (1 min):  %.2f\n", data.load1);
    printf("Load average (5 min):  %.2f\n", data.load5);
    printf("Load average (15 min): %.2f\n", data.load15);

    return 1;
}


/* Process sensor: named FIFO */

int get_proc_data(int fd) {
    ProcData data;

    int result = receive_data(fd, &data, sizeof(data));

    if (result != 1)
        return result;

    printf("\n--- Process Information ---\n");
    printf("Total processes: %d\n", data.total_procs);

    return 1;
}


/* Read one structure from each sensor */

int get_data(void) {
    int result;

    result = get_mem_data(fds[0]);
    if (result != 1)
        return result;

    result = get_cpu_data(cpu_fd);
    if (result != 1)
        return result;

    result = get_proc_data(proc_fd);
    if (result != 1)
        return result;

    return 1;
}


int make_dir(void) {
    if (mkdir("/tmp/sysmon", 0755) == -1 && errno != EEXIST) {
        perror("mkdir");
        return 1;
    }

    return 0;
}


/* Launch one sensor process */

int make_proc(int num) {
    char *path;

    if (num == 0)
        path = "./bin/mem_sensor";
    else if (num == 1)
        path = "./bin/cpu_sensor";
    else if (num == 2)
        path = "./bin/proc_sensor";
    else
        return 1;

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork");
        return 1;
    }

    if (pid == 0) {
        char fd_str[16];
        char *args[3] = {path, NULL, NULL};

        if (num == 0) {
            close(fds[0]);

            snprintf(fd_str, sizeof(fd_str), "%d", fds[1]);
            args[1] = fd_str;
        }
        else {
            close(fds[0]);

            if (fds[1] != -1)
                close(fds[1]);
        }

        execve(path, args, environ);

        perror("execve");
        _exit(1);
    }

    if (num == 0) {
        close(fds[1]);
        fds[1] = -1;
    }

    return 0;
}


int main(void) {

    /* Prepare IPC resources */

    if (make_dir() != 0)
        return 1;

    if (make_fifo(CPU_FIFO_PATH) != 0)
        return 1;

    if (make_fifo(PROC_FIFO_PATH) != 0)
        return 1;

    if (make_pipe() != 0)
        return 1;


    /* Launch all sensors */

    for (int k = 0; k < 3; k++) {
        if (make_proc(k) != 0) {
            fprintf(stderr, "Failed to create process %d\n", k);
            return 1;
        }
    }


    /* Open the named FIFOs for reading */

    cpu_fd = open(CPU_FIFO_PATH, O_RDONLY);
    if (cpu_fd == -1) {
        perror("open CPU FIFO");
        return 1;
    }

    proc_fd = open(PROC_FIFO_PATH, O_RDONLY);
    if (proc_fd == -1) {
        perror("open process FIFO");
        return 1;
    }


    /* Receive sensor data */

    while (1) {
        int result = get_data();

        if (result == 0) {
            printf("A sensor disconnected\n");
            break;
        }

        if (result == -1) {
            fprintf(stderr, "Sensor communication error\n");
            break;
        }
    }


    /* Cleanup */

    close(fds[0]);
    close(cpu_fd);
    close(proc_fd);

    return 0;
}
